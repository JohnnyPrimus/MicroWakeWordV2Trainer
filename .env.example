# Optional Hugging Face token; avoids anonymous download rate limits.
HF_TOKEN=

# Hugging Face download endpoint. Set this to https://hf-mirror.com if direct
# access to huggingface.co is unavailable.
HF_ENDPOINT=https://hf-mirror.com
# Xet acceleration can fail behind some HTTP proxies; ordinary downloads use
# the mirror's regular HTTPS transfer path and support proxy retries.
HF_HUB_DISABLE_XET=1

# Host interface and port for the FastAPI control panel.
# 0.0.0.0 exposes it to other machines; use 127.0.0.1 for local-only access.
TRAINER_BIND_HOST=0.0.0.0
TRAINER_PORT=8188

# Runtime Setup installs microWakeWord/Piper dependencies with this index.
# Override it if the Huawei Cloud mirror is not appropriate for your network.
PIP_INDEX_URL=https://mirrors.huaweicloud.com/repository/pypi/simple

# Image build dependencies (FastAPI, NumPy, PyArrow, etc.) use a separate index.
# BUILD_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# Route container downloads through a host-side HTTP proxy. The Compose
# service maps host.docker.internal to the host gateway automatically.
HTTP_PROXY=http://host.docker.internal:1080
HTTPS_PROXY=http://host.docker.internal:1080
ALL_PROXY=http://host.docker.internal:1080
# Prefixed with TRAINER_ so a host-wide NO_PROXY can't override it.
TRAINER_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,mirrors.aliyun.com,mirrors.huaweicloud.com
